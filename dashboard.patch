+      if (i >= 0) return c.map((l, j) => (j === i ? { ...l, qty: l.qty + 1 } : l));
+      return [...c, { product_id: p.id, name: p.name, unit_price: p.sale_price, qty: 1, disc: '' }];
+    });
+  }
+
+  function submitSearch(e?: React.KeyboardEvent) {
+    const s = q.trim();
+    if (!s) return;
