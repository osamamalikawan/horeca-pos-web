+
+const round3 = (n: number) => Math.round(n * 1000) / 1000;
+
+const KINDS: { kind: Kind; label: string }[] = [
+  { kind: 'cash', label: 'Cash' }, { kind: 'bank', label: 'Bank' },
+  { kind: 'easypaisa', label: 'Easypaisa' }, { kind: 'jazzcash', label: 'JazzCash' },
+];
+
